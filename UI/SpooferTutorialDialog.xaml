<Window x:Class="GameLauncher.UI.SpooferTutorialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How the Spoofer System Works" Height="600" Width="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#CDD6F4"
        FontFamily="Segoe UI, Inter, Cascadia Code, sans-serif"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="WarpButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FAB387"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>

        <Style x:Key="TutorialCard" TargetType="Border">
            <Setter Property="Background" Value="#181826"/>
            <Setter Property="BorderBrush" Value="#2B2B3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogBorderContainer" Background="#11111B" BorderBrush="#313244" BorderThickness="1" CornerRadius="16" Margin="10" Opacity="0.0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="scaleDialog" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="Auto"/>
                <!-- Progress Header -->
                <RowDefinition Height="Auto"/>
                <!-- Body -->
                <RowDefinition Height="*"/>
                <!-- Footer Navigation -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="How the Spoofer System Works" FontSize="20" FontWeight="Bold" Foreground="#CBA6F7" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnCloseIcon" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Foreground="#A6ADC8" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" 
                        Cursor="Hand" Click="btnClose_Click"/>
            </Grid>

            <!-- PROGRESS & STEP NAV BAR -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <!-- Interactive Step Selector Pills -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button x:Name="btnStepPill1" Content="1 Overview" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="1" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill2" Content="2 Hostname" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="2" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill3" Content="3 NetFixer" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="3" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill4" Content="4 Network" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="4" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill5" Content="5 Router IP" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="5" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill6" Content="6 Clean Files" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="6" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill7" Content="7 GUID" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="7" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill8" Content="8 Auto Spoof" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="8" Padding="10,4" Margin="0,0,6,6"/>
                    <Button x:Name="btnStepPill9" Content="9 Launch &amp; VPN" Style="{StaticResource SecondaryButton}" Click="btnStepPill_Click" Tag="9" Padding="10,4" Margin="0,0,0,6"/>
                </WrapPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#25273C" BorderBrush="#CBA6F7" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,14,0">
                        <TextBlock x:Name="txtStepBadge" Text="Step 1 of 9" FontSize="12" FontWeight="Bold" Foreground="#CBA6F7"/>
                    </Border>
                    <ProgressBar Grid.Column="1" x:Name="pbTutorialProgress" Minimum="1" Maximum="9" Value="1" Height="8" VerticalAlignment="Center" Foreground="#CBA6F7" Background="#1E1E2E" BorderThickness="0"/>
                </Grid>
            </StackPanel>

            <!-- STEP CONTENT BODY -->
            <Grid Grid.Row="2" x:Name="StepContentContainer">
                <!-- STEP 1 -->
                <Border x:Name="step1View" Style="{StaticResource TutorialCard}" BorderBrush="#CBA6F7">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🛡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="How the Spoofer Works" FontSize="16" FontWeight="Bold" Foreground="#CBA6F7"/>
                        </StackPanel>
                        <TextBlock Text="This tab lets you change your system identifiers, wipe Warframe account data, and refresh your network." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="20"/>
                        <Border Background="#141420" CornerRadius="10" Padding="14" BorderBrush="#2B2B3F" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 What gets checked:" FontSize="12" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                                <TextBlock Text="Warframe checks your Windows MachineGUID, Hostname, Account cache folders (%LOCALAPPDATA%\Warframe), Registry keys, and your Public IP. Spoofing resets each of these vectors." 
                                           FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 2 -->
                <Border x:Name="step2View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🖥️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hostname (Computer Name)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <TextBlock Text="Warframe checks your computer name and username in crash reports and logs. Clicking Randomize generates a clean Windows hostname." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="20"/>
                        <TextBlock Text="The new hostname takes effect when Windows restarts." 
                                   FontSize="13" Foreground="#A6E3A1" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Target: Click 'Randomize' in the System Identity card." FontSize="12" FontFamily="Consolas" Foreground="#A6ADC8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 3 -->
                <Border x:Name="step3View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔧" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="NetFixer (MAC Address)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <TextBlock Text="NetFixer randomizes the MAC address on your active network adapters and restarts them to apply the new address." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20"/>
                        <TextBlock Text="This changes your local adapter physical address without needing reboot." 
                                   FontSize="13" Foreground="#A6E3A1" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14" LineHeight="18"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Target: Click 'NetFixer' in Manual Tools." FontSize="12" FontFamily="Consolas" Foreground="#A6ADC8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 4 -->
                <Border x:Name="step4View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Network Settings (Network Reset)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                            </StackPanel>
                            <TextBlock Text="Flushes DNS cache, releases and renews your local IP, and resets the Windows TCP/IP stack." 
                                       FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#12121E" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Commands executed:" FontSize="13" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                                    <TextBlock Text="1. ipconfig /flushdns (clears DNS cache)&#10;2. arp -d * (clears ARP table)&#10;3. ipconfig /release &amp; /renew (refreshes local IP)&#10;4. netsh winsock reset &amp; netsh int ip reset" 
                                               FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- STEP 5 -->
                <Border x:Name="step5View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Changing your Public IP" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <TextBlock Text="If your public IP didn't change after Network Settings, you can restart your modem/router." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20"/>
                        <TextBlock Text="Turn off your modem or unplug the power cable for about 15-30 seconds so your internet provider allocates a new public IP." 
                                   FontSize="13" Foreground="#FAB387" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14" LineHeight="18"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Tip: Open 'Dynamic IP Changer' for step-by-step instructions." FontSize="12" Foreground="#A6ADC8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 6 -->
                <Border x:Name="step6View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🧹" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clean Warframe Files &amp; Cache" FontSize="16" FontWeight="Bold" Foreground="#A6E3A1"/>
                        </StackPanel>
                        <TextBlock Text="Warframe stores account hashes, crash dumps, and login tokens across AppData and the registry." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="20"/>
                        <TextBlock Text="This cleans all account hash folders in %LOCALAPPDATA%\Warframe, crash logs, all H.Misc cache files in Cache.Windows, and Digital Extremes registry keys (while keeping your keybinds and EE.cfg intact)." 
                                   FontSize="13" Foreground="#A6E3A1" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,14" LineHeight="18"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Target: Click 'Clean Files &amp; Cache' in Manual Tools." FontSize="12" Foreground="#A6E3A1" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 7 -->
                <Border x:Name="step7View" Style="{StaticResource TutorialCard}" BorderBrush="#89B4FA" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🎲" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MachineGUID Spoofing" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <TextBlock Text="Windows assigns a unique MachineGUID stored in HKLM\SOFTWARE\Microsoft\Cryptography." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="20"/>
                        <TextBlock Text="Clicking 'New GUID' generates a new random GUID and applies it directly to the Windows registry." 
                                   FontSize="13" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"/>
                        <Border Background="#161A29" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBlock Text="✔ Included automatically in Auto Spoof." FontSize="13" FontWeight="Bold" Foreground="#89B4FA"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 8 -->
                <Border x:Name="step8View" Style="{StaticResource TutorialCard}" BorderBrush="#F38BA8" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Auto Spoof" FontSize="16" FontWeight="Bold" Foreground="#F38BA8"/>
                        </StackPanel>
                        <TextBlock Text="Auto Spoof runs all steps in order with a single click:" 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="20"/>
                        <TextBlock Text="1. New MachineGUID &amp; Hostname ➔ 2. NetFixer ➔ 3. 10s wait ➔ 4. Clean Files &amp; Cache ➔ 5. Network Settings" 
                                   FontSize="12" Foreground="#F38BA8" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18" FontFamily="Consolas" FontWeight="Bold"/>
                        <Border Background="#2B151C" BorderBrush="#F38BA8" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBlock Text="⚡ Runs everything automatically." FontSize="13" FontWeight="Bold" Foreground="#F38BA8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 9 -->
                <Border x:Name="step9View" Style="{StaticResource TutorialCard}" BorderBrush="#FAB387" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Launching Warframe &amp; VPN Notice" FontSize="16" FontWeight="Bold" Foreground="#FAB387"/>
                        </StackPanel>
                        <TextBlock Text="Use the Launch button in the main tab to start Warframe and inject OwHelper automatically." 
                                   FontSize="13" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="18"/>
                        <Border Background="#28151A" BorderBrush="#F38BA8" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="⚠️ Important: Avoid Cloudflare WARP and Datacenter VPNs" FontSize="13" FontWeight="Bold" Foreground="#F38BA8" Margin="0,0,0,4"/>
                                <TextBlock Text="Warframe's Akamai firewall blocks Cloudflare WARP (1.1.1.1) and known datacenter IP ranges with 'Falha ao entrar, verifique suas informações' (HTTP 403). Use your regular residential connection or a clean IP." FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FOOTER NAVIGATION BUTTONS -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnBack" Content="◀  Previous" Style="{StaticResource SecondaryButton}" Click="btnBack_Click" Width="120" IsEnabled="False"/>
                <Button Grid.Column="2" x:Name="btnNext" Content="Next  ▶" Style="{StaticResource PrimaryButton}" Click="btnNext_Click" Width="120"/>
            </Grid>
        </Grid>
    </Border>
</Window>
