<Window x:Class="GameLauncher.UI.SpooferTutorialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How the Spoofer System Works" Height="600" Width="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#CDD6F4"
        FontFamily="Segoe UI, Inter, Cascadia Code, sans-serif"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="WarpButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FAB387"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>

        <Style x:Key="TutorialCard" TargetType="Border">
            <Setter Property="Background" Value="#181826"/>
            <Setter Property="BorderBrush" Value="#2B2B3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogBorderContainer" Background="#11111B" BorderBrush="#313244" BorderThickness="1" CornerRadius="16" Margin="10" Opacity="0.0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="scaleDialog" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="Auto"/>
                <!-- Progress Header -->
                <RowDefinition Height="Auto"/>
                <!-- Body -->
                <RowDefinition Height="*"/>
                <!-- Footer Navigation -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="How the Spoofer System Works" FontSize="20" FontWeight="Bold" Foreground="#CBA6F7" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnCloseIcon" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Foreground="#A6ADC8" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" 
                        Cursor="Hand" Click="btnClose_Click"/>
            </Grid>

            <!-- PROGRESS HEADER -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#25273C" BorderBrush="#CBA6F7" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,14,0">
                    <TextBlock x:Name="txtStepBadge" Text="Step 1 of 8" FontSize="12" FontWeight="Bold" Foreground="#CBA6F7"/>
                </Border>
                <ProgressBar Grid.Column="1" x:Name="pbTutorialProgress" Minimum="1" Maximum="8" Value="1" Height="8" VerticalAlignment="Center" Foreground="#CBA6F7" Background="#1E1E2E" BorderThickness="0"/>
            </Grid>

            <!-- STEP CONTENT BODY -->
            <Grid Grid.Row="2" x:Name="StepContentContainer">
                <!-- STEP 1 -->
                <Border x:Name="step1View" Style="{StaticResource TutorialCard}" BorderBrush="#CBA6F7">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🛡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="System Identity Restoration Overview" FontSize="16" FontWeight="Bold" Foreground="#CBA6F7"/>
                        </StackPanel>
                        <TextBlock Text="The Spoofer section is designed for users who have been banned from WARFRAME (only) and need to restore their system identity aka evade Warframe bans lol." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="20"/>
                        <Border Background="#141420" CornerRadius="10" Padding="14" BorderBrush="#2B2B3F" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💡 Beginner-Friendly Key Concept:" FontSize="12" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                                <TextBlock Text="Warframe anti-cheat is a piece of shit, but it's still an anti-cheat, so use Spoofer if you got banned" 
                                           FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 2 -->
                <Border x:Name="step2View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🚀" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Run Spoofer (Hardware Identification)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <TextBlock Text="The main Spoofer executable modifies parts of your hardware identification information." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="20"/>
                        <TextBlock Text="To maximize effectiveness, it is recommended to also use the other available functions in this section." 
                                   FontSize="13" Foreground="#FAB387" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Target: Run Spoofer button" FontSize="12" FontFamily="Consolas" Foreground="#A6ADC8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 3 -->
                <Border x:Name="step3View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔧" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="NetFixer (MAC Address Changer)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <TextBlock Text="NetFixer is another stage of the identity reset process." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20"/>
                        <TextBlock Text="It modifies your MAC Address, which is a hardware identifier associated with your network adapter." 
                                   FontSize="13" Foreground="#A6E3A1" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14" LineHeight="18"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Target: NetFixer button" FontSize="12" FontFamily="Consolas" Foreground="#A6ADC8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 4 -->
                <Border x:Name="step4View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Network Settings (Complete Network Reset)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                            </StackPanel>
                            <TextBlock Text="Network Settings is the most complex network reset stage." 
                                       FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#12121E" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Linear Summary:" FontSize="13" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                                    <TextBlock Text="This function is a Windows network configuration reset tool. It checks for administrator privileges, displays a countdown, then performs several network maintenance operations such as flushing DNS, re-registering DNS settings, releasing and renewing the IP address, resetting Winsock, and clearing ARP cache data. After completing all operations, it automatically restarts the computer to apply the changes." 
                                               FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- STEP 5 -->
                <Border x:Name="step5View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dynamic IP Changer (Router Reset)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <TextBlock Text="If Network Settings does not successfully change your IP address, use the Dynamic IP Changer instructions." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20"/>
                        <TextBlock Text="Sometimes manually disconnecting the router power for at least 15 seconds is required to force a new IP lease from the ISP." 
                                   FontSize="13" Foreground="#FAB387" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14" LineHeight="18"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Tip: Access via the 'Dynamic IP Changer' button in Spoofer controls." FontSize="12" Foreground="#A6ADC8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 6 -->
                <Border x:Name="step6View" Style="{StaticResource TutorialCard}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🧹" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clean Warframe Files (Temporary Cache Cleanup)" FontSize="16" FontWeight="Bold" Foreground="#A6E3A1"/>
                        </StackPanel>
                        <TextBlock Text="This option removes temporary Warframe-related files." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="20"/>
                        <TextBlock Text="Some temporary files may contain identifiers or cached information that can cause automatic restrictions." 
                                   FontSize="13" Foreground="#FAB387" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="18"/>
                        <TextBlock Text="The Clean Warframe Files option helps remove these temporary files before launching the game again." 
                                   FontSize="13" Foreground="#A6E3A1" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,14"/>
                        <Border Background="#141420" CornerRadius="10" Padding="12">
                            <TextBlock Text="Status: Integrated &amp; Ready for Cache Removal" FontSize="12" Foreground="#A6E3A1" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 7 -->
                <Border x:Name="step7View" Style="{StaticResource TutorialCard}" BorderBrush="#F38BA8" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Auto Spoof (Stable)" FontSize="16" FontWeight="Bold" Foreground="#F38BA8"/>
                        </StackPanel>
                        <TextBlock Text="Auto Spoof combines all available Spoofer steps into one automated process." 
                                   FontSize="14" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="20"/>
                        <TextBlock Text="It will execute the Spoofer, NetFixer, Clean Warframe Files, and Network Settings sequence automatically." 
                                   FontSize="13" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"/>
                        <Border Background="#2B151C" BorderBrush="#F38BA8" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBlock Text="⚠ Use at your own risk." FontSize="13" FontWeight="Bold" Foreground="#F38BA8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- STEP 8 -->
                <Border x:Name="step8View" Style="{StaticResource TutorialCard}" BorderBrush="#FAB387" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🛡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="VPN Recommendation" FontSize="16" FontWeight="Bold" Foreground="#FAB387"/>
                        </StackPanel>
                        <TextBlock Text="Using a trusted VPN can help protect your public IP address. Some users use VPN services to avoid IP-based restrictions." 
                                   FontSize="13" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="18"/>
                        <Border Background="#1A1826" BorderBrush="#FAB387" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Recommended VPN: 1.1.1.1 (Cloudflare WARP)" FontSize="13" FontWeight="Bold" Foreground="#FAB387" Margin="0,0,0,4"/>
                                <TextBlock Text="Cloudflare WARP is a fast and privacy focused service, so i think you cant get ip ban if you use that vpn" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnDownloadWarp" Content="🌐  Download 1.1.1.1" Style="{StaticResource WarpButton}" Click="btnDownloadWarp_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FOOTER NAVIGATION BUTTONS -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnBack" Content="◀  Previous" Style="{StaticResource SecondaryButton}" Click="btnBack_Click" Width="120" IsEnabled="False"/>
                <Button Grid.Column="2" x:Name="btnNext" Content="Next  ▶" Style="{StaticResource PrimaryButton}" Click="btnNext_Click" Width="120"/>
            </Grid>
        </Grid>
    </Border>
</Window>
