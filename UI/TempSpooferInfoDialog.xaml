<Window x:Class="GameLauncher.UI.TempSpooferInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How Temp vs Perm Spoofers Work" Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#CDD6F4"
        FontFamily="Segoe UI, Inter, Cascadia Code, sans-serif"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentCloseButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#161622"/>
            <Setter Property="BorderBrush" Value="#2B2B3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogBorderContainer" Background="#11111B" BorderBrush="#89B4FA" BorderThickness="1.5" CornerRadius="16" Margin="10" Opacity="0.0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="scaleDialog" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#89B4FA" BlurRadius="22" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="Auto"/>
                <!-- Body -->
                <RowDefinition Height="*"/>
                <!-- Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="How Hardware Spoofers Work (Temp vs Perm)" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                    <Border Background="#25273C" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TECHNICAL ARCHITECTURE" FontSize="10" FontWeight="Bold" Foreground="#89B4FA"/>
                    </Border>
                </StackPanel>

                <Button x:Name="btnCloseIcon" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Foreground="#A6ADC8" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" 
                        Cursor="Hand" Click="btnClose_Click"/>
            </Grid>

            <!-- CONTENT BODY (SCROLLABLE) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">

                    <!-- SECTION 1: WHAT IS A HARDWARE SPOOFER -->
                    <Border Style="{StaticResource InfoCard}" BorderBrush="#89B4FA">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="1. What is a Hardware Identifier (HWID) Spoofer?" FontSize="14" FontWeight="Bold" Foreground="#89B4FA"/>
                            </StackPanel>
                            <TextBlock Text="Modern video games and anti-cheats (like Warframe, Vanguard, EAC, and BattlEye) generate a unique cryptographic hash called a Hardware ID (HWID). This fingerprint is constructed from physical hardware serial numbers, including:" 
                                       FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>
                            <Border Background="#101018" CornerRadius="8" Padding="10">
                                <TextBlock Text="• Hard Drive / NVMe Model &amp; Serial Numbers (SMART storage queries)&#10;• Motherboard (Baseboard) Serial &amp; Asset Tag&#10;• BIOS Serial Number &amp; System UUID (SMBIOS Type 1 &amp; 2)&#10;• CPU Serial &amp; Processor ID&#10;• Network Interface Card (NIC) MAC Address&#10;• Windows System MachineGUID &amp; ProductID" 
                                           FontFamily="Consolas" FontSize="11" Foreground="#A6E3A1" LineHeight="17"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: PERMANENT SPOOFERS (PERM) -->
                    <Border Style="{StaticResource InfoCard}" BorderBrush="#F38BA8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="2. Permanent Spoofers (Perm Spoofer / AMIDEWIN)" FontSize="14" FontWeight="Bold" Foreground="#F38BA8"/>
                            </StackPanel>
                            <TextBlock Text="A Permanent Spoofer directly writes new serials to the physical hardware EEPROM / NVRAM chips on your motherboard." 
                                       FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>
                            <TextBlock Text="• How it works: Uses signed vendor BIOS flash drivers (such as AMI's amifldrv64.sys or amigendrv64.sys) to send low-level IOCTL commands that rewrite the non-volatile SMBIOS DMI tables (/BS, /SS, /SU, /IV)." 
                                       FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,4"/>
                            <TextBlock Text="• Persistence: Modifications are permanent. They survive PC reboots, Windows reformatting, and BIOS updates." 
                                       FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,4"/>
                            <TextBlock Text="• Risks: Can permanently alter motherboard data, does not work on OEM locked motherboards (HP, Dell, laptops), and cannot be undone without manually re-flashing your original serials." 
                                       FontSize="12" Foreground="#FAB387" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: TEMPORARY SPOOFERS (TEMP) -->
                    <Border Style="{StaticResource InfoCard}" BorderBrush="#A6E3A1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="3. Temporary Spoofers (Temp Spoofer / Kernel Driver)" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1"/>
                            </StackPanel>
                            <TextBlock Text="A Temporary Spoofer does not touch your physical BIOS or hardware chips. Instead, it operates entirely inside volatile kernel memory (RAM)." 
                                       FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>
                            <TextBlock Text="• How it works: A kernel driver is loaded into Ring 0. When any program or anti-cheat queries hardware serials via Windows API, WMI, or storage IRPs, the driver intercepts the request and replaces the factory serials with spoofed values in real-time." 
                                       FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,4"/>
                            <TextBlock Text="• Volatile &amp; Safe: As soon as you reboot your PC, the kernel driver unloads and all hardware serials instantly revert to their original factory values." 
                                       FontSize="12" Foreground="#A6E3A1" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,4"/>
                            <TextBlock Text="• Best for Targeted Games: Ideal when you only want to spoof your serials for Warframe while keeping your genuine identity intact for other competitive games." 
                                       FontSize="12" Foreground="#89B4FA" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 4: HOW VULNERABLE DRIVER MAPPING WORKS (BYOVD) -->
                    <Border Style="{StaticResource InfoCard}" BorderBrush="#CBA6F7">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🧬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="4. How Vulnerable Driver Mapping Works (BYOVD / kdmapper)" FontSize="14" FontWeight="Bold" Foreground="#CBA6F7"/>
                            </StackPanel>
                            <TextBlock Text="Windows 64-bit enforces Driver Signature Enforcement (DSE), preventing unsigned drivers from loading natively. The BYOVD (Bring Your Own Vulnerable Driver) architecture circumvents this without compromising Windows security settings:" 
                                       FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>
                            <Border Background="#101018" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="1. Load Signed Driver: Registers and runs a legitimate, digitally signed Intel diagnostic driver (iqvw64e.sys) exposing the NalDevice object." FontSize="11" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                    <TextBlock Text="2. Arbitrary Physical Memory: Exploits IOCTL 0x80862007 to map arbitrary physical and virtual kernel memory." FontSize="11" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                    <TextBlock Text="3. Non-Paged Kernel Pool: Allocates executable kernel memory (NonPagedPoolExecute) for our target driver." FontSize="11" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                    <TextBlock Text="4. Manual PE Mapping: Manually copies sections (.text, .data), resolves IAT imports to ntoskrnl.exe, and applies Base Relocations." FontSize="11" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                    <TextBlock Text="5. Header Wiping: Zeros MZ and PE headers in memory so static memory scanners find nothing." FontSize="11" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                    <TextBlock Text="6. Invoke DriverEntry: Calls DriverEntry(NULL, NULL) to activate memory hooks." FontSize="11" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                    <TextBlock Text="7. Trace Cleaning: Unloads the Intel driver and wipes traces from PiDDBCacheTable and MmUnloadedDrivers." FontSize="11" Foreground="#A6E3A1" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 5: HOW SERIALS ARE ALTERED IN KERNEL SPACE -->
                    <Border Style="{StaticResource InfoCard}" BorderBrush="#FAB387">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="5. How Serials are Altered in Kernel Space" FontSize="14" FontWeight="Bold" Foreground="#FAB387"/>
                            </StackPanel>
                            <TextBlock Text="Once active in the kernel, the driver hooks internal OS dispatch tables:" 
                                       FontSize="12" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                            <TextBlock Text="• Disk Drives: Intercepts SMART_RCV_DRIVE_DATA and IOCTL_STORAGE_QUERY_PROPERTY IRPs on \Driver\Disk. When anti-cheats query the storage controller, our driver overrides the returned serial string with a randomized serial." 
                                       FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,4"/>
                            <TextBlock Text="• SMBIOS &amp; Motherboard: Hooks ExpGetFirmwareTable / NtQuerySystemInformation (SystemFirmwareTableInformation), dynamically sanitizing SMBIOS tables queried by WMIC and user-mode anti-cheat routines." 
                                       FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,4"/>
                            <TextBlock Text="• MAC Address: Randomizes physical adapter MAC queries via NDIS Miniports and updates Windows NetworkAddress registry entries." 
                                       FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 6: COMPARISON TABLE -->
                    <Border Style="{StaticResource InfoCard}" BorderBrush="#89B4FA">
                        <StackPanel>
                            <TextBlock Text="📊 Quick Comparison: Temp vs Perm Spoofer" FontSize="14" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#1E1E2E" Padding="6,4"><TextBlock Text="Feature" FontWeight="Bold" Foreground="#CDD6F4" FontSize="11"/></Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#2B151C" Padding="6,4"><TextBlock Text="Perm Spoofer (AMIDEWIN)" FontWeight="Bold" Foreground="#F38BA8" FontSize="11"/></Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="#152B1E" Padding="6,4"><TextBlock Text="Temp Spoofer (AcpiDev)" FontWeight="Bold" Foreground="#A6E3A1" FontSize="11"/></Border>

                                <!-- Row 1 -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#14141E" Padding="6,4"><TextBlock Text="Persistence" FontSize="11" Foreground="#A6ADC8"/></Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="#181418" Padding="6,4"><TextBlock Text="Permanent (Survives Reboot)" FontSize="11" Foreground="#CDD6F4"/></Border>
                                <Border Grid.Row="1" Grid.Column="2" Background="#141814" Padding="6,4"><TextBlock Text="Temporary (Resets on PC Reboot)" FontSize="11" Foreground="#A6E3A1" FontWeight="Bold"/></Border>

                                <!-- Row 2 -->
                                <Border Grid.Row="2" Grid.Column="0" Background="#14141E" Padding="6,4"><TextBlock Text="Hardware Safety" FontSize="11" Foreground="#A6ADC8"/></Border>
                                <Border Grid.Row="2" Grid.Column="1" Background="#181418" Padding="6,4"><TextBlock Text="High risk on locked BIOS" FontSize="11" Foreground="#FAB387"/></Border>
                                <Border Grid.Row="2" Grid.Column="2" Background="#141814" Padding="6,4"><TextBlock Text="100% Safe (RAM only)" FontSize="11" Foreground="#A6E3A1"/></Border>

                                <!-- Row 3 -->
                                <Border Grid.Row="3" Grid.Column="0" Background="#14141E" Padding="6,4"><TextBlock Text="Other Games" FontSize="11" Foreground="#A6ADC8"/></Border>
                                <Border Grid.Row="3" Grid.Column="1" Background="#181418" Padding="6,4"><TextBlock Text="May cause NVRAM flags" FontSize="11" Foreground="#F38BA8"/></Border>
                                <Border Grid.Row="3" Grid.Column="2" Background="#141814" Padding="6,4"><TextBlock Text="Clean after reboot for any game" FontSize="11" Foreground="#A6E3A1"/></Border>

                                <!-- Row 4 -->
                                <Border Grid.Row="4" Grid.Column="0" Background="#14141E" Padding="6,4"><TextBlock Text="Target Scope" FontSize="11" Foreground="#A6ADC8"/></Border>
                                <Border Grid.Row="4" Grid.Column="1" Background="#181418" Padding="6,4"><TextBlock Text="Global system motherboard" FontSize="11" Foreground="#CDD6F4"/></Border>
                                <Border Grid.Row="4" Grid.Column="2" Background="#141814" Padding="6,4"><TextBlock Text="Warframe session isolation" FontSize="11" Foreground="#89B4FA"/></Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Right" Content="Got it, Close" Style="{StaticResource AccentCloseButton}" Click="btnClose_Click" Width="130"/>
            </Grid>
        </Grid>
    </Border>
</Window>
