<Window x:Class="GameLauncher.UI.AutoSpoofConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Auto Spoof" Height="480" Width="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#CDD6F4"
        FontFamily="Segoe UI, Inter, Cascadia Code, sans-serif"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.35"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RedConfirmButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogBorderContainer" Background="#181114" BorderBrush="#F38BA8" BorderThickness="2" CornerRadius="16" Margin="10" Opacity="0.0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="scaleDialog" ScaleX="0.85" ScaleY="0.85"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#F38BA8" BlurRadius="24" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <!-- Titlebar -->
                <RowDefinition Height="Auto"/>
                <!-- Body -->
                <RowDefinition Height="*"/>
                <!-- Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚨" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Confirm Auto Spoof" FontSize="20" FontWeight="Bold" Foreground="#F38BA8" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnCloseIcon" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Foreground="#A6ADC8" Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold" 
                        Cursor="Hand" Click="btnCancel_Click"/>
            </Grid>

            <!-- CONTENT BODY -->
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Border Background="#28151A" BorderBrush="#F38BA8" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="This process will automatically execute all Spoofer steps." 
                                   FontSize="14" FontWeight="Bold" Foreground="#F38BA8" Margin="0,0,0,6"/>
                        <TextBlock Text="Make sure you understand what each step does before continuing." 
                                   FontSize="13" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- SEQUENTIAL WORKFLOW LIST -->
                <Border Background="#120D10" BorderBrush="#3B2028" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Automated Execution Sequence:" FontSize="12" FontWeight="Bold" Foreground="#FAB387" Margin="0,0,0,8"/>
                        <TextBlock Text="1. Run Spoofer (PSWOA hardware ID modification)" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                        <TextBlock Text="2. NetFixer (MAC address randomizer)" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                        <TextBlock Text="3. Standby Delay (10 seconds pause)" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                        <TextBlock Text="4. Clean Warframe Files (Temporary cache cleanup)" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,4"/>
                        <TextBlock Text="5. Network Settings (Flush DNS &amp; Winsock reset - auto reboot)" FontSize="12" Foreground="#A6ADC8"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FOOTER ACTION BUTTONS -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnCancel" Content="Cancel" Style="{StaticResource ModernButton}" Click="btnCancel_Click" Width="110"/>
                <Button Grid.Column="2" x:Name="btnConfirm" Content="Confirm (5)" Style="{StaticResource RedConfirmButton}" Click="btnConfirm_Click" Width="140" IsEnabled="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
