<Window x:Class="GameLauncher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GameLauncher.Models"
        xmlns:ui="clr-namespace:GameLauncher.UI"
        xmlns:core="clr-namespace:GameLauncher.Core"
        Title="GameLauncher - Warframe Companion"
        Height="768" Width="1280"
        MinHeight="640" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, Cascadia Code, sans-serif"
        MouseMove="Window_MouseMove">

    <Window.Resources>
        <!-- TITLE BAR BUTTON STYLE -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bg" Value="#26273B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bg" Value="#1A1B2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TITLE BAR CLOSE BUTTON STYLE -->
        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bg" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bg" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN PRIMARY BUTTON STYLE (Launch Warframe) -->
        <Style x:Key="PrimaryLaunchButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#89B4FA" Offset="0"/>
                        <GradientStop Color="#CBA6F7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Padding" Value="26,13"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform x:Name="btnScale" ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" Color="#89B4FA" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.92"/>
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#CBA6F7" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.3"/>
                                <Setter Property="Effect" TargetName="border" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN SECONDARY BUTTON STYLE -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1D2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#2F3045"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#262842"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#141524"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AIO CHEAT BUTTON STYLE (Vibrant Gradient #CBA6F7 / #F38BA8) -->
        <Style x:Key="AioCheatButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CBA6F7" Offset="0"/>
                        <GradientStop Color="#F38BA8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Padding" Value="26,13"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" Color="#F38BA8" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.92"/>
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F38BA8" BlurRadius="22" ShadowDepth="0" Opacity="0.75"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.3"/>
                                <Setter Property="Effect" TargetName="border" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DANGER BUTTON STYLE (Red #F38BA8 / Launch OwHelper) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" Color="#F38BA8" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.9"/>
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F38BA8" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.3"/>
                                <Setter Property="Effect" TargetName="border" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CIRCULAR ICON BUTTON STYLE -->
        <Style x:Key="CircularIconButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1D2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#2F3045"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#262842"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#141524"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- REALISTIC DASHBOARD WIDGET CARD STYLE -->
        <Style x:Key="DashboardWidgetCard" TargetType="Border">
            <Setter Property="Background" Value="#161624"/>
            <Setter Property="BorderBrush" Value="#2B2B3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- OUTER WINDOW FRAME BORDER -->
    <Border x:Name="OuterWindowBorder" Background="#0A0B12" BorderBrush="#26273B" BorderThickness="1" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="scaleWindowMaterialize" ScaleX="0.82" ScaleY="0.82"/>
        </Border.RenderTransform>
        <Grid>
            <!-- GAMELAUNCHER CINEMATIC BACKGROUND ENGINE (3D PARTICLES, FOG & ENERGY CORE) -->
            <core:CinematicBackgroundEngine x:Name="cinematicBgEngine" IsHitTestVisible="False"/>

            <!-- MULTI-LAYER CINEMATIC AMBIENT MOUSE LIGHTING ENGINE -->
            <!-- Layer 2: Wide Secondary Ambient Diffusion -->
            <Rectangle x:Name="BackgroundGlowRectAmbient" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush x:Name="BackgroundGlowBrushAmbient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop x:Name="stopAmbientCenter" Color="#2589B4FA" Offset="0"/>
                        <GradientStop x:Name="stopAmbientEdge" Color="#000A0B12" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Layer 3: Cinematic Trailing Light -->
            <Rectangle x:Name="BackgroundGlowRectTrail" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush x:Name="BackgroundGlowBrushTrail" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
                        <GradientStop x:Name="stopTrailCenter" Color="#30CBA6F7" Offset="0"/>
                        <GradientStop x:Name="stopTrailEdge" Color="#000A0B12" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Layer 1: Primary Mouse Core Light Source -->
            <Rectangle x:Name="BackgroundGlowRectCore" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush x:Name="BackgroundGlowBrushCore" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.45" RadiusY="0.45">
                        <GradientStop x:Name="stopCoreCenter" Color="#5089B4FA" Offset="0"/>
                        <GradientStop x:Name="stopCoreEdge" Color="#000A0B12" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Background Layer 2: Subtle Ambient Floating Orbs -->
            <Canvas IsHitTestVisible="False" Opacity="0.35">
                <Ellipse Width="360" Height="360" Canvas.Left="-70" Canvas.Top="-70" Fill="#1889B4FA">
                    <Ellipse.Effect>
                        <BlurEffect Radius="100"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="400" Height="400" Canvas.Right="-90" Canvas.Bottom="-90" Fill="#14CBA6F7">
                    <Ellipse.Effect>
                        <BlurEffect Radius="110"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- MAIN GRID LAYOUT -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Custom Window Title Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Main Window Content Container -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CUSTOM WINDOW TITLE BAR -->
                <Border Grid.Row="0" x:Name="TitleBarGrid" Background="#0F0F1A" BorderBrush="#222234" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: App Icon, Title & Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" BorderBrush="#89B4FA" BorderThickness="1">
                                <Image x:Name="imgHeaderProfile" Source="pack://application:,,,/Assets/profile.png" Width="24" Height="24" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="Warframe AIO Tool" FontSize="13" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                            <Border Background="#25273C" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.0 STABLE" FontSize="10" FontWeight="Bold" Foreground="#89B4FA"/>
                            </Border>
                        </StackPanel>

                        <!-- Center: Draggable Spacer -->
                        <Grid Grid.Column="1" Background="Transparent"/>

                        <!-- Right: Window Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnWindowMinimize" Style="{StaticResource TitleBarBtn}" Click="btnWindowMinimize_Click" ToolTip="Minimize">
                                <TextBlock Text="─" FontSize="10" FontWeight="Bold"/>
                            </Button>
                            <Button x:Name="btnWindowMaximize" Style="{StaticResource TitleBarBtn}" Click="btnWindowMaximize_Click" ToolTip="Maximize / Restore">
                                <TextBlock x:Name="txtWindowMaximizeIcon" Text="🗗" FontSize="12"/>
                            </Button>
                            <Button x:Name="btnWindowClose" Style="{StaticResource TitleBarCloseBtn}" Click="btnWindowClose_Click" ToolTip="Close">
                                <TextBlock Text="✕" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN ANIMATED CONTENT CONTAINER -->
                <Grid Grid.Row="1" x:Name="MainContentContainer" Margin="28,20" Opacity="1.0">
                    <Grid.RowDefinitions>
                        <!-- Header Section -->
                        <RowDefinition Height="Auto"/>
                        <!-- Dashboard Metrics Cards -->
                        <RowDefinition Height="Auto"/>
                        <!-- Launcher Platform Cards & Actions -->
                        <RowDefinition Height="Auto"/>
                        <!-- Real-Time Activity Log Viewer -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER SECTION WITH MODULE NAVIGATION TABS -->
                    <Grid Grid.Row="0" x:Name="animHeader" Margin="0,0,0,24" Opacity="0.0">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="18"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title, Creator Credit & Subtitle -->
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Warframe AIO Tool" FontSize="28" FontWeight="ExtraBold" Foreground="#89B4FA" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#89B4FA" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Border Background="#25273C" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v2.0 STABLE" FontSize="11" FontWeight="Bold" Foreground="#89B4FA"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="made by #1 Matt fan in rffc with love" FontSize="12" FontWeight="SemiBold" Foreground="#CBA6F7" Margin="0,3,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Discord SDK Killer &amp; WF Launcher" FontSize="13" Foreground="#A6ADC8"/>
                                <TextBlock Text=" • " FontSize="13" Foreground="#585B70"/>
                                <TextBlock x:Name="txtLauncherType" Text="Launcher: Epic Games" FontSize="13" FontWeight="SemiBold" Foreground="#FAB387"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Ambient Audio Controls & Module Navigation Tab Switcher -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Minimalist Ambient Audio Control Widget -->
                            <Border x:Name="borderAudioControl" Background="#161624" BorderBrush="#2B2B3F" BorderThickness="1" CornerRadius="10" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="btnAudioMute" Width="28" Height="28" Style="{StaticResource CircularIconButton}" Click="btnAudioMute_Click" ToolTip="Toggle Music Mute">
                                        <TextBlock x:Name="txtAudioMuteIcon" Text="🔊" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Slider x:Name="sliderAudioVolume" Width="85" VerticalAlignment="Center" Margin="8,0,6,0" Minimum="0" Maximum="100" Value="80" ValueChanged="sliderAudioVolume_ValueChanged" ToolTip="Music Volume"/>
                                    <TextBlock x:Name="txtAudioVolumeValue" Text="80%" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" Width="32" TextAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161624" BorderBrush="#2B2B3F" BorderThickness="1" CornerRadius="10" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnTabDashboard" Content="⚡  Dashboard" Style="{StaticResource SecondaryButton}" Click="btnTabDashboard_Click" Margin="0,0,4,0" Padding="14,6"/>
                                    <Button x:Name="btnTabUpdater" Content="🚀  Updater" Style="{StaticResource SecondaryButton}" Click="btnTabUpdater_Click" Margin="0,0,4,0" Padding="14,6"/>
                                    <Button x:Name="btnTabSpoofer" Content="🎭  Spoofer" Style="{StaticResource SecondaryButton}" Click="btnTabSpoofer_Click" Margin="0" Padding="14,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- DASHBOARD MODULE VIEW (CONTAINER TAB) -->
                    <Grid x:Name="gridDashboardView" Grid.Row="1" Grid.RowSpan="3" Opacity="1.0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="transDashboard" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <!-- Dashboard Metrics Cards -->
                            <RowDefinition Height="Auto"/>
                            <!-- Launcher Platform Cards & Actions -->
                            <RowDefinition Height="Auto"/>
                            <!-- Real-Time Activity Log Viewer -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- DASHBOARD CARDS ROW -->
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CARD 1: SDK KILLER STATUS -->
                            <Border Grid.Column="0" x:Name="animCardStatus" Style="{StaticResource DashboardWidgetCard}" Margin="0,0,12,0" Opacity="0.0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="18"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtCardStatusIcon" Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="SDK KILLER STATUS" FontSize="11" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtCardStatus" Text="SDK Killer Active" FontSize="20" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="txtStatusSubtext" Text="Watching Warframe launch" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: OWHELPER STATUS -->
                            <Border Grid.Column="1" x:Name="animCardCounter" Style="{StaticResource DashboardWidgetCard}" Margin="6,0,6,0" Opacity="0.0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="18"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="txtOwHelperCardIcon" Text="⚪" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="OWHELPER STATUS" FontSize="11" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtOwHelperCardStatus" Text="Not Started" FontSize="20" FontWeight="Bold" Foreground="#6C7086" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="txtOwHelperCardSubtext" Text="OwHelper has not been launched" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: DISCORD SDK STATUS -->
                            <Border Grid.Column="2" x:Name="animCardSdk" Style="{StaticResource DashboardWidgetCard}" Margin="12,0,0,0" Opacity="0.0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="18"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧩" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DISCORD SDK STATUS" FontSize="11" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtSdkStatus" Text="Active (Backup Present)" FontSize="20" FontWeight="Bold" Foreground="#FAB387" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="txtSdkSubtext" Text="discord_game_sdk.dll" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- LAUNCHER PLATFORM CARDS + ACTION BUTTONS -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,24">
                            <!-- LAUNCHER CARDS HEADER -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SELECT LAUNCHER PLATFORM" FontSize="12" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="btnSettings" Content="⚙  Settings" Style="{StaticResource SecondaryButton}" Click="btnSettings_Click" Padding="14,8"/>
                            </Grid>

                            <!-- LAUNCHER CARDS PANEL -->
                            <Grid x:Name="animLauncherPanel" Margin="0,0,0,20" Opacity="0.0">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="18"/>
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CARD 1: EPIC GAMES -->
                                <Border x:Name="cardEpic" Grid.Column="0" Background="#161624" BorderBrush="#89B4FA" BorderThickness="2" CornerRadius="14" Padding="16,14" Margin="0,0,8,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="cardEpic_MouseLeftButtonDown">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Margin="0,0,10,0" Width="32" Height="32" VerticalAlignment="Center">
                                                    <Image x:Name="imgEpicLogo" Source="pack://application:,,,/Assets/epic_games.png" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                                </Grid>
                                                <TextBlock Text="Epic Games" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="badgeEpicSelected" Text="✓ Selected" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Launch through Epic Games Launcher with Epic account authentication" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="16"/>
                                    </Grid>
                                </Border>

                                <!-- CARD 2: STEAM -->
                                <Border x:Name="cardSteam" Grid.Column="1" Background="#161624" BorderBrush="#2B2B3F" BorderThickness="1" CornerRadius="14" Padding="4,0,4,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="cardSteam_MouseLeftButtonDown">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Margin="0,0,10,0" Width="32" Height="32" VerticalAlignment="Center">
                                                    <Image x:Name="imgSteamLogo" Source="pack://application:,,,/Assets/steam.png" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                                </Grid>
                                                <TextBlock Text="Steam" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="badgeSteamSelected" Text="✓ Selected" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Launch through Steam protocol" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="16"/>
                                    </Grid>
                                </Border>

                                <!-- CARD 3: STANDALONE -->
                                <Border x:Name="cardStandalone" Grid.Column="2" Background="#161624" BorderBrush="#2B2B3F" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="8,0,0,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="cardStandalone_MouseLeftButtonDown">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Margin="0,0,10,0" Width="32" Height="32" VerticalAlignment="Center">
                                                    <Image x:Name="imgStandaloneLogo" Source="pack://application:,,,/Assets/warframe.png" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                                </Grid>
                                                <TextBlock Text="Standalone" FontSize="16" FontWeight="Bold" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="badgeStandaloneSelected" Text="✓ Selected" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="Launch using local Warframe Launcher.exe" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap" LineHeight="16"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ACTION BUTTONS PANEL -->
                            <WrapPanel x:Name="animActionButtons" Orientation="Horizontal" Opacity="0.0">
                                <WrapPanel.RenderTransform>
                                    <TranslateTransform Y="18"/>
                                </WrapPanel.RenderTransform>
                                <Button x:Name="btnLaunchWarframe" Content="🚀  Launch Warframe" Style="{StaticResource PrimaryLaunchButton}" Click="btnLaunchWarframe_Click"/>
                                <Button x:Name="btnAioCheat" Content="⚡  AIO Cheat Execution" Style="{StaticResource AioCheatButton}" Click="btnAioCheat_Click"/>
                                <Button x:Name="btnToggleMonitoring" Content="✔  SDK Killer Active" Style="{StaticResource SecondaryButton}" Click="btnToggleMonitoring_Click"/>
                                <Button x:Name="btnLaunchOwHelper" Content="☣  Launch OwHelper" Style="{StaticResource DangerButton}" Click="btnLaunchOwHelper_Click"/>
                                <Button x:Name="btnRestore" Content="🛠  Restore Discord SDK (Debug)" Style="{StaticResource SecondaryButton}" Click="btnRestore_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- REAL-TIME LOG VIEWER -->
                        <Border Grid.Row="2" x:Name="animLogConsole" Background="#12121D" BorderBrush="#252538" BorderThickness="1" CornerRadius="14" Padding="18" Opacity="0.0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="18"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtLogConsoleHeader" Text="REAL-TIME ACTIVITY LOGS" FontSize="12" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <ListBox Grid.Row="1" x:Name="lstLogs" Background="Transparent" BorderThickness="0"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13" Padding="10" AlternationCount="2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:LogEntry}">
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="{Binding FormattedTimestamp}" Foreground="{Binding TimestampHexColor}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DisplayText}" Foreground="{Binding HexColor}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter Property="Background" Value="#0AFFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SPOOFER MODULE VIEW (CONTAINER TAB) -->
                    <Grid x:Name="gridSpooferView" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0.0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="transSpoofer" Y="12"/>
                        </Grid.RenderTransform>
                        <ui:SpooferControl x:Name="spooferControlView"/>
                    </Grid>

                    <!-- WARFRAME UPDATER MODULE VIEW (CONTAINER TAB) -->
                    <Grid x:Name="gridUpdaterView" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0.0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="transUpdater" Y="12"/>
                        </Grid.RenderTransform>
                        <ui:WarframeUpdaterView x:Name="updaterControlView"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- STARTUP BOOT SEQUENCE OVERLAY -->
            <Grid x:Name="StartupOverlayGrid" IsHitTestVisible="True" Panel.ZIndex="999" Background="#0C0C12" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="scaleStartupContent" ScaleX="0.85" ScaleY="0.85"/>
                    </StackPanel.RenderTransform>

                    <!-- CREATOR AVATAR -->
                    <Border CornerRadius="36" Width="72" Height="72" Margin="0,0,0,14" HorizontalAlignment="Center" BorderBrush="#CBA6F7" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect Color="#CBA6F7" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <Image x:Name="imgStartupProfile" Source="pack://application:,,,/Assets/profile.png" Width="72" Height="72" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- LOGO & BRANDING -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="⚡" FontSize="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStartupLogoTitle" Text="Warframe AIO Tool" FontSize="34" FontWeight="ExtraBold" Foreground="#D6D6E0" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="shadowStartupLogo" Color="#D6D6E0" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border Background="#25273C" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.0 STABLE" FontSize="11" FontWeight="Bold" Foreground="#89B4FA"/>
                        </Border>
                    </StackPanel>

                    <!-- CREATOR CREDIT SUBTEXT -->
                    <TextBlock Text="made by #1 Matt fan in rffc with love" FontSize="13" FontWeight="SemiBold" Foreground="#CBA6F7" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                    <!-- ANIMATED SPINNER RING -->
                    <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="48" Height="48" BorderThickness="3" CornerRadius="24" RenderTransformOrigin="0.5,0.5">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="spinStopAccent" Color="#D6D6E0" Offset="0.0"/>
                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.RenderTransform>
                                <RotateTransform x:Name="spinnerRotate" Angle="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- BOOT STATUS & PROGRESS SUBTEXT -->
                    <TextBlock x:Name="txtBootStatus" Text="> Initializing Warframe AIO Tool Core..." FontSize="13" FontWeight="Bold" Foreground="#D6D6E0" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtBootProgress" Text="[●○○○] Loading modules..." FontSize="12" Foreground="#89B4FA" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                    <!-- SIMULATED LOG TERMINAL BOX -->
                    <Border Background="#09090E" BorderBrush="#1C1C28" BorderThickness="1" CornerRadius="10" Padding="14,12" Height="140">
                        <ScrollViewer x:Name="scrollBootLogs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="panelBootLogs" Orientation="Vertical"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
